# -------------------------------------------------------------
# Elastic Beanstalk Environment Properties Example
# -------------------------------------------------------------
# These variables must be configured in the AWS Elastic Beanstalk Console 
# (Environment -> Configuration -> Updates, routing, and scaling -> Environment properties)

# Server Port (Elastic Beanstalk listens on 5000 by default for Java platform, 
# but Spring Boot uses 8080. You can set SERVER_PORT to 5000 to match EB.)
SERVER_PORT=5000

# Active Profile
SPRING_PROFILES_ACTIVE=prod

# RDS PostgreSQL Database Connection
RDS_HOSTNAME=your-database-instance-id.region.rds.amazonaws.com
RDS_PORT=5432
RDS_DB_NAME=scamshield
RDS_USERNAME=postgres
RDS_PASSWORD=your_secure_password

# JWT Authentication Secret (Must be a strong, base64 encoded string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
